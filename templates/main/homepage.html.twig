{% extends 'base.html.twig' %}

{% block title %}Starshop - Homepage{% endblock %}

{% block body %}
  <h1>Starshop</h1>

  <div>{{ startShipCount }}</div>

  <h2>My Ship</h2>

  <table>
    <tr>
      <th>Name</th>
      <td><a href="{{ path('starship_show', {id: ship.id}) }}">{{ ship.name }}</a></td>
    </tr>
    <tr>
      <th>Captain</th>
      <td>{{ ship.captain }}</td>
    </tr>
    <tr>
      <th>Class</th>
      <td>{{ ship.class }}</td>
    </tr>
  </table>

{% endblock %}
